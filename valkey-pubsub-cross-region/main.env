# Copy to main.env on the Frankfurt VM. Keep credentials out of source control.
VALKEY_HOST=your-frankfurt-primary-endpoint.redis.eu-frankfurt-1.oci.oraclecloud.com
VALKEY_PORT=6379
VALKEY_TLS=true
VALKEY_USERNAME=
VALKEY_PASSWORD=
# Optional CA bundle path; system certificate roots are used when empty.
VALKEY_CA_CERT=
GAME_CHANNEL=game.events
GAME_STATE_KEY=game:state
REGION_LABEL=Frankfurt
APP_HOST=0.0.0.0
APP_PORT=5000
PUBLISH_INTERVAL=0.25
