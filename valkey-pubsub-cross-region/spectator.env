# Copy to spectator.env on the Amsterdam VM. Never point this at Frankfurt.
VALKEY_HOST=your-amsterdam-endpoint.redis.eu-amsterdam-1.oci.oraclecloud.com
VALKEY_PORT=6379
VALKEY_TLS=true
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_CA_CERT=
GAME_CHANNEL=game.events
GAME_STATE_KEY=game:state
REGION_LABEL=Amsterdam
APP_HOST=0.0.0.0
APP_PORT=5001
# true: bootstrap/recover through the replicated state key; false: strict Pub/Sub.
SNAPSHOT_FALLBACK=true
SNAPSHOT_POLL_INTERVAL=1
